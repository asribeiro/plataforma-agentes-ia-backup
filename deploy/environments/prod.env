# PRODUÇÃO — meu-agente.transformativa.com.br
# Usado assim:  docker compose --env-file deploy/environments/prod.env up -d --build
#
# Segredos NÃO ficam neste arquivo:
#   POSTGRES_PASSWORD  -> /etc/plataforma-agentes/postgres-prod/password   (600, dono root)
#   chaves de app      -> .env.backend do diretório de produção            (600)
# Este arquivo é versionado e não pode conter segredo nenhum.
COMPOSE_PROJECT_NAME=plataforma-agentes
ENVIRONMENT=production

# Imagem própria do ambiente (build once + promote: em homolog/dev o nome é outro).
APP_IMAGE=plataforma-agentes-backend:prod
WEB_IMAGE=plataforma-agentes-web:prod

# Portas de loopback: quem fala com o mundo é a borda (/opt/borda), não estes serviços.
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8083
API_BIND_HOST=127.0.0.1
API_PORT=8002

# Banco: instância própria, nunca compartilhada com outro ambiente.
POSTGRES_DB=plataforma_agentes
POSTGRES_USER=plataforma_agentes

# Concorrência do worker de produção.
WORKER_CONCURRENCY=2

# Só o profile `edge-local` usa estes valores (a borda pública é outra stack).
PUBLIC_DOMAIN=meu-agente.transformativa.com.br
ACME_EMAIL=anderson.ribeiro@transformativa.com.br
EDGE_HTTP_BIND_HOST=0.0.0.0
EDGE_HTTP_PORT=8080
EDGE_HTTPS_BIND_HOST=0.0.0.0
EDGE_HTTPS_PORT=443
