# DESENVOLVIMENTO — dev.agente.transformativa.com.br (atrás de basic auth na borda)
# Usado assim:  docker compose --env-file deploy/environments/dev.env up -d
#
# Segredos em /etc/plataforma-agentes/*-dev/ (600) e no .env.backend do diretório de dev.
# WhatsApp desligado (WAHA_ENABLED=false no .env.backend): mensagem é exercitada por webhook simulado.
COMPOSE_PROJECT_NAME=plataforma-agentes-dev
ENVIRONMENT=development

APP_IMAGE=plataforma-agentes-backend:dev
WEB_IMAGE=plataforma-agentes-web:dev

WEB_BIND_HOST=127.0.0.1
WEB_PORT=8092
API_BIND_HOST=127.0.0.1
API_PORT=8012

POSTGRES_DB=plataforma_agentes_dev
POSTGRES_USER=plataforma_agentes

# Um worker só: dev não pode consumir a RAM que produção precisa.
WORKER_CONCURRENCY=1

PUBLIC_DOMAIN=dev.agente.transformativa.com.br
ACME_EMAIL=anderson.ribeiro@transformativa.com.br
EDGE_HTTP_BIND_HOST=127.0.0.1
EDGE_HTTP_PORT=8091
EDGE_HTTPS_BIND_HOST=127.0.0.1
EDGE_HTTPS_PORT=8543
