# HOMOLOGAÇÃO — homolog.agente.transformativa.com.br (atrás de basic auth na borda)
# Usado assim:  docker compose --env-file deploy/environments/homolog.env up -d
#
# Segredos em /etc/plataforma-agentes/*-homolog/ (600) e no .env.backend do diretório de homolog.
# Nada de credencial de produção aqui: WAHA com chip próprio, OAuth do Google com projeto de teste.
COMPOSE_PROJECT_NAME=plataforma-agentes-homolog
ENVIRONMENT=staging

APP_IMAGE=plataforma-agentes-backend:homolog
WEB_IMAGE=plataforma-agentes-web:homolog

WEB_BIND_HOST=127.0.0.1
WEB_PORT=8082
API_BIND_HOST=127.0.0.1
API_PORT=8011

POSTGRES_DB=plataforma_agentes_homolog
POSTGRES_USER=plataforma_agentes

# Igual à produção: homolog precisa reproduzir a carga real de trabalho, não uma versão aliviada.
WORKER_CONCURRENCY=2

PUBLIC_DOMAIN=homolog.agente.transformativa.com.br
ACME_EMAIL=anderson.ribeiro@transformativa.com.br
EDGE_HTTP_BIND_HOST=127.0.0.1
EDGE_HTTP_PORT=8081
EDGE_HTTPS_BIND_HOST=127.0.0.1
EDGE_HTTPS_PORT=8443
